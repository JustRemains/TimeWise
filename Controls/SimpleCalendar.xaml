<UserControl x:Class="TimeWise.Controls.SimpleCalendar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="150" MinHeight="180">
    <Grid Background="{DynamicResource CalendarBackgroundBrush}">
        <StackPanel>
            <!-- Header with month/year and navigation -->
            <Grid Height="30" Background="{DynamicResource PanelBackgroundBrush}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="30"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="30"/>
                </Grid.ColumnDefinitions>
                
                <Button x:Name="PrevButton" Grid.Column="0" Content="‹" 
                        Background="Transparent" BorderBrush="Transparent"
                        Foreground="{DynamicResource TextForegroundBrush}"
                        Click="PrevButton_Click"/>
                
                <TextBlock x:Name="MonthYearText" Grid.Column="1" 
                           Text="August 2025" TextAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextForegroundBrush}"
                           FontWeight="Bold"/>
                
                <Button x:Name="NextButton" Grid.Column="2" Content="›"
                        Background="Transparent" BorderBrush="Transparent"
                        Foreground="{DynamicResource TextForegroundBrush}"
                        Click="NextButton_Click"/>
            </Grid>
            
            <!-- Days of week header -->
            <Grid Height="25">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                
                <TextBlock Grid.Column="0" Text="Sun" TextAlignment="Center" 
                           Foreground="{DynamicResource TextForegroundBrush}" FontSize="10"/>
                <TextBlock Grid.Column="1" Text="Mon" TextAlignment="Center" 
                           Foreground="{DynamicResource TextForegroundBrush}" FontSize="10"/>
                <TextBlock Grid.Column="2" Text="Tue" TextAlignment="Center" 
                           Foreground="{DynamicResource TextForegroundBrush}" FontSize="10"/>
                <TextBlock Grid.Column="3" Text="Wed" TextAlignment="Center" 
                           Foreground="{DynamicResource TextForegroundBrush}" FontSize="10"/>
                <TextBlock Grid.Column="4" Text="Thu" TextAlignment="Center" 
                           Foreground="{DynamicResource TextForegroundBrush}" FontSize="10"/>
                <TextBlock Grid.Column="5" Text="Fri" TextAlignment="Center" 
                           Foreground="{DynamicResource TextForegroundBrush}" FontSize="10"/>
                <TextBlock Grid.Column="6" Text="Sat" TextAlignment="Center" 
                           Foreground="{DynamicResource TextForegroundBrush}" FontSize="10"/>
            </Grid>
            
            <!-- Calendar grid -->
            <UniformGrid x:Name="CalendarGrid" Rows="6" Columns="7" 
                        MinHeight="120"/>
        </StackPanel>
    </Grid>
</UserControl>
