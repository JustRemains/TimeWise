<Window x:Class="TimeWise.DeleteAppointment"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TimeWise"
        mc:Ignorable="d"
        Title="DeleteAppointment" Height="250" Width="250">
    <Grid>
        <StackPanel>
            <Label Content="Delete Appointment" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,10,0,20"/>
            <Label Content="Enter Appointment Title To Delete" HorizontalAlignment="Center" FontWeight="Bold"/>
            <TextBox Name="appointmentTitle" Margin="20,0,20,0" Text="Title"/>
            <Button Name="deleteButton" Content="Delete Appointment" Margin="20,20,20,0" Height="40" Click="DeleteButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
