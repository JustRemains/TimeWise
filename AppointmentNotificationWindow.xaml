<Window x:Class="TimeWise.AppointmentNotificationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Appointment Reminder"
        Height="420"
        Width="450"
        WindowStartupLocation="Manual"
        Topmost="True"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False">

    <Window.Resources>
        <Style x:Key="ModernButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#3498db"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#2980b9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#21618c"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource ModernButtonStyle}">
            <Setter Property="Background" Value="#95a5a6"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#7f8c8d"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#6c7b7d"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border Background="White" 
            CornerRadius="12" 
            BorderBrush="#e1e8ed" 
            BorderThickness="1"
            Margin="10"
            MouseLeftButtonDown="Window_MouseLeftButtonDown">
        <Border.Effect>
            <DropShadowEffect Color="Black" 
                            Direction="315" 
                            ShadowDepth="8" 
                            Opacity="0.15" 
                            BlurRadius="15"/>
        </Border.Effect>
        
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="55"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="70"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" 
                    x:Name="HeaderBorder"
                    Background="#3498db" 
                    CornerRadius="12,12,0,0"
                    MouseLeftButtonDown="HeaderBorder_MouseLeftButtonDown"
                    Cursor="SizeAll">
                <StackPanel Orientation="Horizontal" 
                          VerticalAlignment="Center" 
                          HorizontalAlignment="Center"
                          Margin="20,0">
                    <Ellipse Width="32" Height="32" 
                           Fill="#2980b9" 
                           Margin="0,0,12,0">
                        <Ellipse.Effect>
                            <DropShadowEffect Color="Black" Opacity="0.2" BlurRadius="3"/>
                        </Ellipse.Effect>
                    </Ellipse>
                    <TextBlock Text="🔔" 
                             FontSize="18" 
                             VerticalAlignment="Center"
                             Margin="-44,0,12,0"/>
                    <TextBlock Text="Appointment Reminder" 
                             FontSize="16" 
                             FontWeight="SemiBold" 
                             Foreground="White"
                             VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- Content Area -->
            <StackPanel Grid.Row="1" 
                       Margin="25,20,25,15">
                
                <!-- Appointment Title -->
                <TextBlock x:Name="AppointmentTitleText"
                         Text="Appointment Title"
                         FontSize="20"
                         FontWeight="Bold"
                         Foreground="#2c3e50"
                         TextWrapping="Wrap"
                         Margin="0,0,0,15"/>
                
                <!-- Time Information -->
                <StackPanel Orientation="Horizontal" 
                          Margin="0,0,0,20">
                    <Border Background="#ecf0f1" 
                           CornerRadius="15" 
                           Padding="8,4"
                           Margin="0,0,8,0">
                        <TextBlock Text="⏰" 
                                 FontSize="16" 
                                 VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock x:Name="AppointmentTimeText"
                             Text="Today 2:30 PM - 3:30 PM"
                             FontSize="15"
                             Foreground="#34495e"
                             VerticalAlignment="Center"/>
                </StackPanel>
                
                <!-- Countdown Display -->
                <Border CornerRadius="10" 
                       Padding="20,18"
                       BorderBrush="#dee2e6"
                       BorderThickness="2"
                       Margin="0,5,0,0">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#f8f9fa" Offset="0"/>
                            <GradientStop Color="#e9ecef" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <StackPanel>
                        <TextBlock x:Name="CountdownLabel"
                                 Text="Time remaining:"
                                 FontSize="14"
                                 FontWeight="SemiBold"
                                 Foreground="#495057"
                                 HorizontalAlignment="Center"
                                 Margin="0,0,0,10"/>
                        
                        <TextBlock x:Name="CountdownText"
                                 Text="15 minutes"
                                 FontSize="28"
                                 FontWeight="Bold"
                                 Foreground="#e67e22"
                                 HorizontalAlignment="Center"
                                 TextAlignment="Center"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Button Area -->
            <Grid Grid.Row="2" 
                  Background="#f8f9fa" 
                  Margin="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <Button Grid.Column="0"
                       x:Name="SnoozeButton"
                       Content="Snooze (5 min)"
                       Style="{StaticResource SecondaryButtonStyle}"
                       Margin="20,18,10,18"
                       Click="SnoozeButton_Click"/>
                
                <Button Grid.Column="1"
                       x:Name="OkButton"
                       Content="Got it"
                       Style="{StaticResource ModernButtonStyle}"
                       Margin="10,18,20,18"
                       Click="OkButton_Click"/>
            </Grid>
        </Grid>
    </Border>
</Window>
