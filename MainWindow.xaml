<Window x:Class="TimeWise.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TimeWise" Height="800" 
        Width="1500">
    <Window.Resources>
        <!-- Modern Delete Button Style -->
        <Style x:Key="CircularDeleteButton" TargetType="Button">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="15">
                            <Border.Effect>
                                <DropShadowEffect Color="Black" BlurRadius="4" Opacity="0.3" ShadowDepth="2"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#FF8B0000" Offset="0"/>
                                            <GradientStop Color="#FFDC143C" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="border" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="1.1" ScaleY="1.1"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.95" ScaleY="0.95"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" 
                                               To="1.1" Duration="0:0:0.1"/>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" 
                                               To="1.1" Duration="0:0:0.1"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" 
                                               To="1.0" Duration="0:0:0.1"/>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" 
                                               To="1.0" Duration="0:0:0.1"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.ExitActions>
                </Trigger>
            </Style.Triggers>
        </Style>
        
        <!-- Modern Add Button Style -->
        <Style x:Key="CircularAddButton" TargetType="Button">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="35">
                            <Border.Effect>
                                <DropShadowEffect Color="#FF4169E1" BlurRadius="8" Opacity="0.6" ShadowDepth="3"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#FF32CD32" Offset="0"/>
                                            <GradientStop Color="#FF228B22" Offset="0.5"/>
                                            <GradientStop Color="#FF006400" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="border" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#FF32CD32" BlurRadius="12" Opacity="0.8" ShadowDepth="4"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.9" ScaleY="0.9"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" 
                                               To="1.15" Duration="0:0:0.2"/>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" 
                                               To="1.15" Duration="0:0:0.2"/>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" 
                                               To="90" Duration="0:0:0.3"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" 
                                               To="1.0" Duration="0:0:0.2"/>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" 
                                               To="1.0" Duration="0:0:0.2"/>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" 
                                               To="0" Duration="0:0:0.3"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.ExitActions>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Enhanced Card Style -->
        <Style x:Key="AppointmentCard" TargetType="Border">
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="15"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="Gray" BlurRadius="6" Opacity="0.3" ShadowDepth="3"/>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect Color="Gray" BlurRadius="10" Opacity="0.5" ShadowDepth="5"/>
                        </Setter.Value>
                    </Setter>
                    <Setter Property="RenderTransform">
                        <Setter.Value>
                            <TranslateTransform Y="-2"/>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel x:Name="Header" Grid.Row="0" Orientation="Horizontal" Grid.ColumnSpan="2">

            <Label Content="TimeWise" 
                   FontSize="45" 
                   FontWeight="Bold" 
                   HorizontalAlignment="Center" 
                   VerticalAlignment="Center"
                   Margin="200,0,0,0"
                   />

            <Button x:Name="Settings" FontSize="20"
                    Width="100" 
                    Height="40" 
                    Margin="800,0,0,0" 
                    HorizontalAlignment="Center" 
                    VerticalAlignment="Bottom" Background="{x:Null}" BorderBrush="{x:Null}">
                <Image Source="/Images/icons/Gear.png"/>
            </Button>

            <Button x:Name="Darkmode"
                    FontSize="20"
                    Width="100" 
                    Height="40" 
                    Margin="20,0,0,0" 
                    HorizontalAlignment="Center" 
                    VerticalAlignment="Bottom" Background="{x:Null}" BorderBrush="{x:Null}">
                <Image Source="/Images/icons/Dark.png"/>
            </Button>

        </StackPanel>


        <StackPanel x:Name="SidePanel" Grid.Column="0" Grid.Row="1" Grid.RowSpan="2" Orientation="Vertical" Margin="0,0,0,0">

            <Calendar x:Name="MainCalendar" 
                      Margin="0,20,0,0" 
                      Grid.Row="1" 
                      Grid.Column="0"/>

            <Border BorderBrush="Black" 
                    BorderThickness="1" 
                    Margin="10,10,10,0" 
                    Background="#FFF0F0F0" RenderTransformOrigin="0.5,0.5"/>

            <Label Content="Category Filters" 
                   FontSize="20" 
                   FontWeight="Bold" 
                   HorizontalAlignment="Center" 
                   Margin="0,5,0,0"/>

            <CheckBox Content="Work" Margin="10,5,0,0" Background="LightBlue"/>
            <CheckBox Content="Personal" Margin="10,5,0,0" Background="LightGreen"/>
            <CheckBox Content="Health" Margin="10,5,0,0" Background="Yellow"/>
            <CheckBox Content="Hobbies" Margin="10,5,0,0" Background="Orange"/>

            <TextBox x:Name="SearchBox" 
                     Margin="10,20,10,0" 
                     Height="21" 
                     Text="Search appointments..." Width="178" HorizontalAlignment="Right" HorizontalContentAlignment="Center"/>

            <Border BorderBrush="Black" 
                    BorderThickness="1" 
                    Margin="10,10,10,0" 
                    Background="#FFF0F0F0"/>

            <Label Content="Notes" 
                   FontSize="20" 
                   FontWeight="Bold" 
                   HorizontalAlignment="Center" 
                   Margin="0,5,0,0"/>

            <TextBox x:Name="NotesBox" 
                     Margin="10,10,10,0" 
                     Height="245" 
                     TextWrapping="Wrap" 
                     VerticalScrollBarVisibility="Auto" 
                     AcceptsReturn="True"/>

            <Border BorderBrush="Black" 
                    BorderThickness="1" 
                    Margin="10,10,10,0" 
                    Background="#FFF0F0F0"/>

            <TextBlock Text="Notes will be saved automatically." 
                       HorizontalAlignment="Center" 
                       VerticalAlignment="Center"/>
        </StackPanel>

        <Grid Grid.Row="1" Grid.Column="1" Margin="10,0,0,0">
            <TabControl x:Name="MainTabControl">
                <TabItem Header="Day" Height="20" Width="100">
                    <DockPanel>
                        <!-- Add Button first to reserve space at bottom -->
                        <Button DockPanel.Dock="Bottom" Content="+" FontSize="32" FontWeight="Bold" 
                                Width="70" Height="70" 
                                HorizontalAlignment="Center" VerticalAlignment="Center" 
                                Margin="15" Foreground="White" 
                                BorderBrush="Green" Style="{StaticResource CircularAddButton}"
                                Click="AddAppointment_Click">
                            <Button.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#FF00CED1" Offset="0"/>
                                    <GradientStop Color="#FF4169E1" Offset="0.5"/>
                                    <GradientStop Color="#FF0000FF" Offset="1"/>
                                </LinearGradientBrush>
                            </Button.Background>
                            <Button.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform/>
                                    <RotateTransform/>
                                </TransformGroup>
                            </Button.RenderTransform>
                        </Button>
                        
                        <!-- ScrollViewer takes remaining space -->
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel x:Name="appointmentList" Margin="10,10,10,10">
                                <!-- Daily appointments will be loaded here dynamically -->
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                </TabItem>
                
                <TabItem Header="Week" Height="20" Width="100" VerticalAlignment="Center">
                    <DockPanel>
                        <!-- Add Button first to reserve space at bottom -->
                        <Button DockPanel.Dock="Bottom" Content="+" FontSize="32" FontWeight="Bold" 
                                Width="70" Height="70" 
                                HorizontalAlignment="Center" VerticalAlignment="Center" 
                                Margin="15" Foreground="White" 
                                BorderBrush="Green" Style="{StaticResource CircularAddButton}"
                                Click="AddAppointment_Click">
                            <Button.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#FF00CED1" Offset="0"/>
                                    <GradientStop Color="#FF4169E1" Offset="0.5"/>
                                    <GradientStop Color="#FF0000FF" Offset="1"/>
                                </LinearGradientBrush>
                            </Button.Background>
                            <Button.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform/>
                                    <RotateTransform/>
                                </TransformGroup>
                            </Button.RenderTransform>
                        </Button>
                        
                        <!-- ScrollViewer takes remaining space -->
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel x:Name="weekAppointmentList" Margin="10,10,10,10">
                                <!-- Weekly appointments will be loaded here dynamically -->
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                </TabItem>
            </TabControl>
        </Grid>
    </Grid>
</Window>
