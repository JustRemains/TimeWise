<Window x:Class="TimeWise.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TimeWise" Height="800" 
        Width="1500">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel x:Name="Header" Grid.Row="0" Orientation="Horizontal" Grid.ColumnSpan="2">

            <Label Content="TimeWise" 
                   FontSize="45" 
                   FontWeight="Bold" 
                   HorizontalAlignment="Center" 
                   VerticalAlignment="Center"
                   Margin="200,0,0,0"
                   />

            <!--Needs button images-->
            <Button Content="Settings"
                    FontSize="20"
                    Width="100" 
                    Height="40" 
                    Margin="800,0,0,0" 
                    HorizontalAlignment="Center" 
                    VerticalAlignment="Center"/>

            <Button Content="DarkMode"
                    FontSize="20"
                    Width="100" 
                    Height="40" 
                    Margin="20,0,0,0" 
                    HorizontalAlignment="Center" 
                    VerticalAlignment="Center"/>

        </StackPanel>
        <Border Grid.Row="0" 
                Grid.Column="0" 
                Grid.ColumnSpan="2"
                BorderBrush="Black" 
                BorderThickness="0,0,0,1" 
                Margin="0,0,0,0"/>


        <StackPanel x:Name="SidePanel" Grid.Column="0" Grid.Row="1" Orientation="Vertical">

            <Calendar Margin="0,20,0,0" 
                      Grid.Row="1" 
                      Grid.Column="0"/>
            <Border BorderBrush="Black" 
                    BorderThickness="1" 
                    Margin="10,10,10,0" 
                    Background="#FFF0F0F0" RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform/>
                        <SkewTransform/>
                        <RotateTransform Angle="-0.139"/>
                        <TranslateTransform/>
                    </TransformGroup>
                </Border.RenderTransform>
            </Border>

            <Label Content="Category Filters" 
                   FontSize="20" 
                   FontWeight="Bold" 
                   HorizontalAlignment="Center" 
                   Margin="0,5,0,0"/>
            <CheckBox Content="Work" Margin="10,5,0,0"/>
            <CheckBox Content="Personal" Margin="10,5,0,0"/>
            <CheckBox Content="Health" Margin="10,5,0,0"/>
            <CheckBox Content="Hobbies" Margin="10,5,0,0"/>

            <TextBox x:Name="SearchBox" 
                     Margin="10,20,10,0" 
                     Height="21" 
                     Text="Search appointments..." Width="178" HorizontalAlignment="Right" HorizontalContentAlignment="Center"/>

            <Border BorderBrush="Black" 
                    BorderThickness="1" 
                    Margin="10,10,10,0" 
                    Background="#FFF0F0F0"/>

            <Label Content="Notes" 
                   FontSize="20" 
                   FontWeight="Bold" 
                   HorizontalAlignment="Center" 
                   Margin="0,5,0,0"/>
            <TextBox x:Name="NotesBox" 
                     Margin="10,10,10,0" 
                     Height="245" 
                     TextWrapping="Wrap" 
                     VerticalScrollBarVisibility="Auto" 
                     AcceptsReturn="True"/>
            <Border BorderBrush="Black" 
                    BorderThickness="1" 
                    Margin="10,10,10,0" 
                    Background="#FFF0F0F0"/>
            <TextBlock Text="Notes will be saved automatically." 
                           HorizontalAlignment="Center" 
                           VerticalAlignment="Center"/>
        </StackPanel>







    </Grid>
</Window>
