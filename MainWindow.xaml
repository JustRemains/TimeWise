<Window x:Class="TimeWise.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TimeWise" Height="800" 
        Width="1500">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel x:Name="Header" Grid.Row="0" Orientation="Horizontal" Grid.ColumnSpan="2">

            <Label Content="TimeWise" 
                   FontSize="45" 
                   FontWeight="Bold" 
                   HorizontalAlignment="Center" 
                   VerticalAlignment="Center"
                   Margin="200,0,0,0"
                   />

            <!-- Fixed Button with Image -->
            <Button x:Name="Settings" FontSize="20"
                    Width="100" 
                    Height="40" 
                    Margin="800,0,0,0" 
                    HorizontalAlignment="Center" 
                    VerticalAlignment="Bottom" Background="{x:Null}" BorderBrush="{x:Null}">
                <Image Source="/Images/icons/Gear.png"/>
            </Button>

            <Button x:Name="Darkmode"
                    FontSize="20"
                    Width="100" 
                    Height="40" 
                    Margin="20,0,0,0" 
                    HorizontalAlignment="Center" 
                    VerticalAlignment="Bottom" Background="{x:Null}" BorderBrush="{x:Null}">
                <Image Source="/Images/icons/Dark.png"/>
            </Button>

        </StackPanel>


        <StackPanel x:Name="SidePanel" Grid.Column="0" Grid.Row="1" Grid.RowSpan="2" Orientation="Vertical" Margin="0,0,0,0">

            <Calendar Margin="0,20,0,0" 
                      Grid.Row="1" 
                      Grid.Column="0"/>

            <Border BorderBrush="Black" 
                    BorderThickness="1" 
                    Margin="10,10,10,0" 
                    Background="#FFF0F0F0" RenderTransformOrigin="0.5,0.5"/>
            
            <Label Content="Category Filters" 
                   FontSize="20" 
                   FontWeight="Bold" 
                   HorizontalAlignment="Center" 
                   Margin="0,5,0,0"/>
            
            <CheckBox Content="Work" Margin="10,5,0,0" Background="Blue"/>
            <CheckBox Content="Personal" Margin="10,5,0,0" Background="Green"/>
            <CheckBox Content="Health" Margin="10,5,0,0" Background="Yellow"/>
            <CheckBox Content="Hobbies" Margin="10,5,0,0" Background="Orange"/>

            <TextBox x:Name="SearchBox" 
                     Margin="10,20,10,0" 
                     Height="21" 
                     Text="Search appointments..." Width="178" HorizontalAlignment="Right" HorizontalContentAlignment="Center"/>

            <Border BorderBrush="Black" 
                    BorderThickness="1" 
                    Margin="10,10,10,0" 
                    Background="#FFF0F0F0"/>

            <Label Content="Notes" 
                   FontSize="20" 
                   FontWeight="Bold" 
                   HorizontalAlignment="Center" 
                   Margin="0,5,0,0"/>
            
            <TextBox x:Name="NotesBox" 
                     Margin="10,10,10,0" 
                     Height="245" 
                     TextWrapping="Wrap" 
                     VerticalScrollBarVisibility="Auto" 
                     AcceptsReturn="True"/>
            
            <Border BorderBrush="Black" 
                    BorderThickness="1" 
                    Margin="10,10,10,0" 
                    Background="#FFF0F0F0"/>
            
            <TextBlock Text="Notes will be saved automatically." 
                       HorizontalAlignment="Center" 
                       VerticalAlignment="Center"/>
        </StackPanel>

        <Grid Grid.Row="2" Grid.Column="1">

            <TabControl>
                <TabItem Header="Daily"/>
                <TabItem Header="Weekly"/>
            </TabControl>
            
            <ScrollViewer>
                <Border BorderBrush="Black" BorderThickness="2,2,0,0" Margin="10,10,10,10">
                    <StackPanel Orientation="Vertical">
                        
                    </StackPanel>
                </Border>
            </ScrollViewer>
        </Grid>
        

    </Grid>
</Window>
